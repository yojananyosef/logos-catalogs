# Dart / Flutter
.dart_tool/
.packages
build/
pubspec.lock          # library packages: lock is not committed

# Built modules are large binaries. They are published as release artefacts and
# referenced from catalog.json by sha256 + URL, so the catalog stays reviewable
# as text even when the payloads are not in git.
dist/*.amod
*.amod

# Tooling
.idea/
.vscode/
*.iml
.DS_Store

# Third-party test data. 4.9 MB of CC BY 4.0 cross-references, fetched rather than
# committed for the same reason the modules are: it is a payload, not source. The test
# names the URL and the licence in its skip reason.
test/fixtures/crossreferences_kjv.tsv
